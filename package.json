{
  "name": "f1-brand-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "catalog:sync": "NODE_PATH=./node_modules/next/dist/compiled node --conditions=react-server --import tsx scripts/sync-catalog.ts",
    "legal:check": "tsx scripts/legal-check.ts",
    "data:retention": "tsx scripts/retention.ts",
    "test:legal": "tsx --test tests/legal.test.ts",
    "test:legal:integration": "tsx tests/legal-integration.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^15.5.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.5.18",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
