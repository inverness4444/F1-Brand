# Public site origin
NEXT_PUBLIC_SITE_URL=https://velocityclub.ru
APP_URL=https://velocityclub.ru
# Set to false for preview/staging deployments that should not be indexed.
NEXT_PUBLIC_SITE_INDEXABLE=true

# PostgreSQL physically located in Russia, including replicas and backups.
# Verify the provider's actual locations; a Russian domain alone is not evidence.
DATABASE_URL="postgresql://USER:PASSWORD@DB_HOST_IN_RUSSIA/DB?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@DB_HOST_IN_RUSSIA/DB?sslmode=require"
# Optional runtime pool overrides for Prisma. The defaults are safe for local Next.js and production builds.
PRISMA_CONNECTION_LIMIT=5
PRISMA_POOL_TIMEOUT=30
# Public catalog source: "auto" reads the database when reachable and falls back to files locally/build-time.
CATALOG_SOURCE=auto
CATALOG_FALLBACK_LOGS=false

# Server auth. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL=https://velocityclub.ru
NEXTAUTH_URL=https://velocityclub.ru

# Seed/demo admin account. Use only for local development or controlled staging seeds.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin12345!
SEED_USER_EMAIL=customer@example.com
SEED_USER_PASSWORD=Customer12345!
SEED_CREATE_TEST_ORDER=false

# YooKassa server-only credentials. Leave empty for local mock mode.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://velocityclub.ru/checkout/success
YOOKASSA_WEBHOOK_SECRET=

# Receipt/54-FZ config. Required when "Чеки от ЮKassa" are enabled for the shop.
YOOKASSA_RECEIPT_ENABLED=true
YOOKASSA_VAT_CODE=1
YOOKASSA_TAX_SYSTEM_CODE=
YOOKASSA_PAYMENT_SUBJECT=commodity
YOOKASSA_PAYMENT_MODE=full_prepayment

# Local mock payment confirmation is disabled in production unless explicitly enabled.
ENABLE_MOCK_PAYMENTS=false

# Optional distributed rate limiting. Verify Russian location and processing terms before sending IP addresses.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=

# Real seller details: public, used in contacts, offer and consent text. Never use sample addresses in production.
NEXT_PUBLIC_SELLER_ADDRESS=
NEXT_PUBLIC_SELLER_REGISTRATION_AUTHORITY=
NEXT_PUBLIC_RETURN_ADDRESS=
NEXT_PUBLIC_RETURN_RECIPIENT=
# Guaranteed calendar days, including weekends and holidays, for all destinations enabled online.
NEXT_PUBLIC_PRODUCTION_MAX_CALENDAR_DAYS=
NEXT_PUBLIC_DELIVERY_MAX_CALENDAR_DAYS=
# Server attestations: enable only after documented checks, not to bypass a failed payment.
# RF verification covers app/DB, replicas, backups, logs and any Redis provider.
PERSONAL_DATA_RF_VERIFIED=false
RKN_NOTIFICATION_VERIFIED=false
FISCAL_PROCESS_VERIFIED=false
# The retention command must run daily on the Russian host; see docs/legal-release-checklist.md.
RETENTION_JOB_VERIFIED=false
